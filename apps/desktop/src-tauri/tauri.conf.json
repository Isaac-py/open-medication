{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Medication",
  "version": "0.1.0",
  "identifier": "com.openmedication.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Open Medication",
        "width": 420,
        "height": 720,
        "visible": false,
        "resizable": true,
        "backgroundColor": "#f4f1ea"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
